{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Реквизиты проекта — context/project.yml",
  "type": "object",
  "required": ["name", "summary", "sync"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 300 },
    "stack": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "reality": {
      "description": "Где правда о «как сейчас»: this-repo или ключи external",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "preset": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "namespaces": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "external": {
      "description": "Где что живёт вне репозитория: имя → URL или указатель",
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exceptions": {
          "description": "Core-роли, заменённые или исключённые пресетом",
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        }
      }
    },
    "briefing": {
      "description": "Дефолты брифинга оператора; cheap — тикеты делает оператор (доку — librarian, judge — off), roles — конвейер executor → judge, custom — поля явно; запись — oc3 briefing set",
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["cheap", "roles", "custom"] },
        "routing": { "description": "Кто делает тикеты", "enum": ["operator", "executor"] },
        "research": { "description": "Кто делает код-разведку", "enum": ["self", "researcher"] },
        "judge": { "description": "Приёмка тикета judge'ом", "enum": ["on", "off"] },
        "ticket_mode": {
          "description": "Стоп на коммит после каждого тикета или все подряд",
          "enum": ["stop", "all"]
        }
      }
    },
    "sync": {
      "type": "object",
      "required": ["index_source", "contract"],
      "additionalProperties": false,
      "properties": {
        "index_source": { "type": "string", "minLength": 1 },
        "index_sha": { "type": "string", "minLength": 1 },
        "contract": {
          "type": "object",
          "required": ["key"],
          "additionalProperties": false,
          "properties": {
            "key": { "const": "agent-operational-contract-v3" },
            "edition": { "const": "operator-centric" },
            "synced_sha": { "type": "string", "minLength": 1 },
            "parts": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "skills": { "type": "object", "additionalProperties": { "type": "string" } },
                "agents": { "type": "object", "additionalProperties": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
