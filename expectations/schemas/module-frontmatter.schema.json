{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frontmatter модуля — prompts/modules/<key>.md",
  "type": "object",
  "required": ["key", "kind", "applicable_to", "patterns", "title", "use_case"],
  "additionalProperties": false,
  "properties": {
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "kind": { "const": "module" },
    "applicable_to": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "patterns": {
      "type": "array",
      "contains": { "const": "source-sync" },
      "items": { "type": "string" }
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "use_case": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "deprecated": { "type": "string" },
    "feature": {
      "type": "object",
      "required": ["summary", "default", "requires", "conflicts"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
        "default": { "type": "boolean" },
        "requires": { "type": "array", "items": { "type": "string" } },
        "conflicts": { "type": "array", "items": { "type": "string" } },
        "asks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "question", "multi", "options"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "question": { "type": "string", "minLength": 1, "maxLength": 200 },
              "multi": { "type": "boolean" },
              "options": { "type": "array", "minItems": 2, "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
