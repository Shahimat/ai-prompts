{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Отчёт роли — тело сообщения report",
  "type": "object",
  "required": ["done", "checks"],
  "additionalProperties": false,
  "properties": {
    "done": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "checks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "left": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  }
}
