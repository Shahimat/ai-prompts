{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Вердикт judge — .ops/<ticket>/verdicts/<run>.yml",
  "type": "object",
  "required": ["run", "status", "summary", "items"],
  "additionalProperties": false,
  "properties": {
    "run": { "type": "integer", "minimum": 1, "maximum": 3 },
    "status": { "enum": ["pass", "fail", "conflict", "paused"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^\\n]+$" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "status", "evidence", "reason"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "minLength": 1, "maxLength": 200 },
          "status": { "enum": ["pass", "fail", "satisfactorily"] },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 300 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  }
}
