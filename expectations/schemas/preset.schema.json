{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Пресет — presets/<key>.yml",
  "type": "object",
  "required": ["key", "title", "contract", "modules", "role_skills"],
  "additionalProperties": false,
  "properties": {
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "contract": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "answers": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                { "type": "string" },
                { "type": "array", "items": { "type": "string" }, "minItems": 1 }
              ]
            }
          }
        }
      }
    },
    "role_skills": {
      "description": "Install-time дефолт: роль → skills; установщик инвертирует в roles записей context/skills.yml",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
      }
    },
    "role_exceptions": {
      "description": "Core-роли, заменённые или исключённые этим пресетом; установщик пишет их в context/project.yml → roles.exceptions",
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "roles": {
      "description": "Install-time определения ролей пресета; установщик пишет .agents/agents/<name>.md",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "kind",
          "description",
          "model",
          "permissions",
          "lifecycle",
          "concurrency",
          "skills",
          "output",
          "artifacts"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["primary", "core", "custom"] },
          "description": { "type": "string", "minLength": 20, "maxLength": 300 },
          "model": {
            "enum": ["deepseek/deepseek-flash#max", "deepseek/deepseek-flash#low"]
          },
          "permissions": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            ]
          },
          "lifecycle": { "enum": ["persistent", "fresh", "resumable", "paused"] },
          "concurrency": {
            "oneOf": [{ "type": "integer", "minimum": 1 }, { "const": "unlimited" }]
          },
          "skills": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
          },
          "output": { "enum": ["result", "verdict", "question"] },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "autonomy": { "$ref": "autonomy.schema.json" }
  }
}
