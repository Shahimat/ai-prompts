{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "provides модуля — что модуль ставит в проект",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "layers": { "type": "array", "items": { "type": "string" } },
    "files": { "type": "array", "items": { "type": "string" } },
    "skills": { "type": "array", "items": { "type": "string" } },
    "agents_md_block": { "type": "boolean" },
    "harness_checks": { "type": "array", "items": { "type": "string" } },
    "changelog_tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
    "extends": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" }, "minItems": 1 } },
    "index_layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section", "dir"],
        "additionalProperties": false,
        "properties": {
          "section": { "type": "string" },
          "dir": { "type": "string" },
          "format": { "enum": ["md", "yml"] }
        }
      }
    },
    "gitignore": { "type": "array", "items": { "type": "string" } },
    "fields_in_index": { "type": "array", "items": { "type": "string" }, "description": "только v2: секции ручного context/index.yml" }
  }
}
