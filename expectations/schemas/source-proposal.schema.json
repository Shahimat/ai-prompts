{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Предложение проекта на контракте v3 в источник ai-prompts",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "generated_at", "base", "proposals"],
  "properties": {
    "format": { "const": "source-proposal" },
    "version": { "const": 1 },
    "generated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "base": {
      "description": "От какого состояния источника отличается проект; имя проекта не передаётся",
      "type": "object",
      "additionalProperties": false,
      "required": ["index_sha", "contract", "modules"],
      "properties": {
        "index_sha": { "$ref": "#/$defs/sha" },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "synced_sha"],
          "properties": {
            "key": { "$ref": "#/$defs/key" },
            "synced_sha": { "$ref": "#/$defs/sha" }
          }
        },
        "preset": { "$ref": "#/$defs/key" },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "synced_sha"],
            "properties": {
              "key": { "$ref": "#/$defs/key" },
              "synced_sha": { "$ref": "#/$defs/sha" }
            }
          }
        },
        "harness": { "type": "string", "minLength": 1 }
      }
    },
    "proposals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "target",
          "summary",
          "rationale",
          "generalized",
          "evidence",
          "confidence"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/key" },
          "kind": {
            "description": "drift — правка поставленной части; generalization — локальное решение, полезное не только этому проекту; gap — схема молчит, проект придумал своё; friction — правило схемы проект обходит",
            "enum": ["drift", "generalization", "gap", "friction"]
          },
          "target": {
            "description": "Куда в источнике: contract, harness, new или <вид>:<key>",
            "type": "string",
            "pattern": "^(contract|harness|new|(module|skill|agent|pattern|preset):[a-z0-9][a-z0-9-]*)$"
          },
          "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
          "rationale": { "type": "string", "minLength": 1 },
          "generalized": {
            "description": "Предложение без специфики проекта — в форме, пригодной для источника",
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "local_sha": { "$ref": "#/$defs/sha" },
                "source_sha": { "$ref": "#/$defs/sha" },
                "excerpt": { "type": "string", "maxLength": 2000 }
              }
            }
          },
          "confidence": { "enum": ["low", "medium", "high"] }
        }
      }
    }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
