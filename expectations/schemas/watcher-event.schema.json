{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Событие watcher — строка JSONL event log",
  "type": "object",
  "required": ["id", "project", "watch", "type", "created_at"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "minLength": 1 },
    "watch": { "type": "string", "minLength": 1 },
    "type": { "enum": ["timer", "git", "ci", "manual", "external"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^\\n]+$" },
    "payload": { "type": "object" },
    "created_at": { "type": "string", "minLength": 1 },
    "attempts": { "type": "integer", "minimum": 0 }
  }
}
