{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "context/ai-core.yml",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "adapters": {
      "type": "array",
      "items": {
        "enum": ["claude-code", "codex"]
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "changelog": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "max_line": {
              "type": "integer",
              "minimum": 1
            },
            "tags": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "context-index": {
          "type": ["object", "null"],
          "maxProperties": 0
        },
        "adapters": {
          "type": ["object", "null"],
          "maxProperties": 0
        },
        "secrets": {
          "oneOf": [
            {
              "const": false
            },
            {
              "type": ["object", "null"],
              "additionalProperties": false,
              "properties": {
                "allow": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path", "reason"],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "line": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "worktrees": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string"
        }
      }
    },
    "rules": {
      "type": "string"
    },
    "hooks": {
      "description": "Hooks инструментов, которые ставит ai adapters sync: docs-guard — запрет правки документации в основной сессии",
      "type": "array",
      "items": {
        "enum": ["docs-guard"]
      },
      "uniqueItems": true
    }
  }
}
