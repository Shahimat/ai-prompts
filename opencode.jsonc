{
  "default_agent": "build",
  "$schema": "https://opencode.ai/config.json",
  "skills": ["./skills"],
  "permissions": [
    {
      "action": "*memory*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.codex/**/memory/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.config/opencode/**/memory/**",
      "effect": "deny"
    }
  ],
  "worktree": {
    "directory": ".opencode/worktrees"
  },
  "experimental": {
    "todo": true,
    "subagent_depth": 2
  },
  "model": "openai/gpt-6.1-sol-fast",
  "agents": {
    "build": {
      "model": "openai/gpt-6.1-sol-fast"
    },
    "plan": {
      "model": "openai/gpt-6.1-sol-fast"
    },
    "general": {
      "model": "openai/gpt-6.1-sol-fast"
    },
    "explore": {
      "model": "openai/gpt-6.1-sol-fast"
    },
    "compaction": {
      "model": "openai/gpt-6.1-sol-fast"
    },
    "title": {
      "model": "openai/gpt-6.1-sol-fast"
    },
    "summary": {
      "model": "openai/gpt-6.1-sol-fast"
    }
  }
}
