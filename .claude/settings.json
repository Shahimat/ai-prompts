{
  "autoMemoryEnabled": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node node_modules/@shahimat/cli/dist/bin.js docs guard"
          }
        ]
      }
    ]
  }
}
