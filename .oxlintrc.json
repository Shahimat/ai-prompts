{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "node", "vitest"],
  "jsPlugins": ["./packages/oxlint-plugin.ts"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/strict-boolean-expressions": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/restrict-plus-operands": "error",
    "eqeqeq": "error",
    "no-implicit-coercion": "error",
    "typescript/no-misused-spread": "off",
    "vitest/warn-todo": "off",
    "vitest/require-to-throw-message": "off",
    "import/no-relative-parent-imports": "error",
    "local/no-comments": "error"
  },
  "overrides": [
    {
      "files": ["expectations/**/*.ts", "packages/*/src/**/*.ts"],
      "rules": {
        "vitest/no-standalone-expect": "off"
      }
    },
    {
      "files": ["packages/harness/src/lib/expect/levels.ts"],
      "rules": {
        "vitest/valid-title": "off",
        "vitest/expect-expect": "off",
        "vitest/valid-expect": "off"
      }
    },
    {
      "files": ["packages/harness/src/commands/delta/delta.ts"],
      "rules": {
        "unicorn/no-thenable": "off"
      }
    },
    {
      "files": ["packages/harness/src/shared/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["#lib/**", "#commands/**", "#scripts/**", "#harnesses/**"],
                "message": "shared — нижний слой: импортирует только shared"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/harness/src/lib/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["#commands/**", "#scripts/**", "#harnesses/**"],
                "message": "lib импортирует только shared и lib"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/harness/src/commands/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["#scripts/**", "#harnesses/**"],
                "message": "команда не вызывает скрипты и harness"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/harness/src/scripts/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["#harnesses/**"],
                "message": "скрипт агрегирует только команды"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/harness/src/harnesses/core/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "#harnesses/plan-review/**",
                  "#harnesses/docs-delta/**",
                  "#harnesses/source-sync/**"
                ],
                "message": "ядро harness не зависит от конкретного harness"
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["**/dist/**", "packages/harness/test/.tmp/**"]
}
