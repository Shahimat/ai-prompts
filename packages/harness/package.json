{
  "name": "@shahimat/harness",
  "version": "0.4.0",
  "description": "Автоматы (harness) для проектов на контрактах ai-prompts: docs-delta, source-sync, plan-review",
  "license": "MIT",
  "author": "Gevorg Nakhapetyan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shahimat/ai-prompts.git",
    "directory": "packages/harness"
  },
  "homepage": "https://github.com/Shahimat/ai-prompts/tree/main/packages/harness#readme",
  "bugs": {
    "url": "https://github.com/Shahimat/ai-prompts/issues"
  },
  "keywords": [
    "ai-agents",
    "harness",
    "state-machine",
    "claude-code"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./expect": {
      "source": "./src/expect/index.ts",
      "types": "./dist/expect/index.d.ts",
      "import": "./dist/expect/index.js"
    }
  },
  "imports": {
    "#*": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@shahimat/ai-core": "0.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "@shahimat/cli": "0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "vitest": ">=4"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
