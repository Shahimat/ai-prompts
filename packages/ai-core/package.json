{
  "name": "@shahimat/ai-core",
  "version": "0.1.9",
  "description": "Команды для проектов на контрактах ai-prompts: генераторы, проверки, механизм ожиданий и роли",
  "license": "MIT",
  "author": "Gevorg Nakhapetyan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shahimat/ai-prompts.git",
    "directory": "packages/ai-core"
  },
  "homepage": "https://github.com/Shahimat/ai-prompts/tree/main/packages/ai-core#readme",
  "bugs": {
    "url": "https://github.com/Shahimat/ai-prompts/issues"
  },
  "keywords": [
    "ai-agents",
    "agents-md",
    "opencode",
    "codex",
    "docs-as-code",
    "changelog",
    "lint"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./expect": {
      "source": "./src/lib/expect/index.ts",
      "types": "./dist/lib/expect/index.d.ts",
      "import": "./dist/lib/expect/index.js"
    }
  },
  "imports": {
    "#*": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../build.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --conditions=source src/lib/proof/npm.ts",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@hpcc-js/wasm-graphviz": "^1.29.2",
    "ajv": "^8.20.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@shahimat/cli": "0.1.6",
    "@types/node": "^24.19.2",
    "vitest": "^5.0.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
