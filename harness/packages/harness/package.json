{
  "name": "@shahimat/harness",
  "version": "0.4.0",
  "description": "Harness для проектов на контрактах ai-prompts: генераторы и проверки",
  "license": "MIT",
  "author": "Gevorg Nakhapetyan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shahimat/ai-prompts.git",
    "directory": "harness/packages/harness"
  },
  "homepage": "https://github.com/Shahimat/ai-prompts/tree/main/harness/packages/harness#readme",
  "bugs": {
    "url": "https://github.com/Shahimat/ai-prompts/issues"
  },
  "keywords": [
    "ai-agents",
    "agents-md",
    "claude-code",
    "codex",
    "docs-as-code",
    "changelog",
    "lint"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "harness": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./expect": {
      "types": "./dist/expect/index.d.ts",
      "import": "./dist/expect/index.js"
    }
  },
  "files": [
    "dist",
    "harnesses",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/bin.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vitest": ">=4"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
